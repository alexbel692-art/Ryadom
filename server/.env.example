# Домен (или IP) сервера. Домен должен смотреть A-записью на этот VPS.
DOMAIN=remote.example.ru

# Адрес API, который клиенты используют для входа, списка устройств и журнала.
#  с доменом:  https://remote.example.ru
#  только IP:  http://203.0.113.10:21114
API_URL=https://remote.example.ru

# Название в панели и на странице загрузки
APP_NAME=Рядом

# Схема ссылок «Подключиться» из панели. У фирменного клиента Ryadom — ryadom,
# у стандартного клиента RustDesk — rustdesk.
URI_SCHEME=ryadom

# Первый администратор (создаётся при первом запуске, потом пароль меняется в панели)
ADMIN_USER=admin
ADMIN_PASSWORD=смените-меня

# С доменом и Caddy: 127.0.0.1 и TRUST_PROXY=1.  Только IP: 0.0.0.0 и TRUST_PROXY=0.
PANEL_BIND=127.0.0.1
TRUST_PROXY=1

# Сколько дней хранить журнал сеансов
AUDIT_KEEP_DAYS=365
